# Copia este archivo como .env y completa tus valores (nunca lo subas a git).

# Token inventado por ti: debe coincidir con el "Verify token" del panel de Meta.
VERIFY_TOKEN=

# App Dashboard -> Configuración -> Básica -> Clave secreta de la app.
APP_SECRET=

# WhatsApp -> API Setup -> token permanente (usuario de sistema) o temporal.
WHATSAPP_TOKEN=

# WhatsApp -> API Setup -> identificador del número (cambia si migras tu número propio).
PHONE_NUMBER_ID=

# Base de datos PostgreSQL (Render, Supabase, Neon...). Si se deja vacío,
# el bot usa data.json + ./media/ en disco local (se pierde al redesplegar).
# Ejemplo Render: postgres://usuario:clave@host:5432/basedatos
DATABASE_URL=

# Clave de OpenAI para transcribir las notas de voz a texto (Whisper).
# Se crea en https://platform.openai.com/api-keys. Si se deja vacío,
# el bot sigue guardando los audios, pero sin transcripción.
OPENAI_API_KEY=

# Dominio real de Legado Vivo cuando exista (opcional en el piloto).
DEEP_LINK_BASE=https://legadovivo.example/borrador

# true = pruebas locales sin llamadas reales a Meta.
DRY_RUN=false
