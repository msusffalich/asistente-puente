# Copia este archivo como .env y completa los valores (nunca lo subas a git).
# cp .env.example .env

# Token de verificacion que TU inventas. Debe coincidir con el que pegues
# en el panel de Meta (WhatsApp > Configuration > Webhook > Verify token).
VERIFY_TOKEN=cambia-este-valor-por-uno-largo-y-aleatorio

# App Secret de tu app de Meta (App Dashboard > Configuracion > Basica > Clave secreta de la app).
APP_SECRET=

# Token de acceso de WhatsApp (temporal para pruebas o permanente para produccion).
# NUNCA lo compartas ni lo pegues en codigo, chats publicos o repositorios.
WHATSAPP_TOKEN=

# Phone number ID del numero de WhatsApp (el de prueba de Meta o tu numero definitivo).
PHONE_NUMBER_ID=

# Puerto del servidor (Render y otros hosts lo inyectan con PORT).
PORT=3000

# DRY_RUN=true evita llamadas reales a la API de WhatsApp (solo registra en consola).
# Util para probar el webhook localmente sin gastar el token.
DRY_RUN=false
